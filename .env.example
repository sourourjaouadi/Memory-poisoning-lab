# Model Provider Selection: 'mock', 'openai', 'anthropic', 'ollama'
MODEL_PROVIDER=mock

# Model IDs
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_MODEL=llama3.2

# API Keys (optional if using 'mock' or 'ollama')
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama / Local API configuration
OLLAMA_BASE_URL=http://localhost:11434/v1

# Storage Paths
DATA_DIR=data
LOGS_DIR=logs
SQLITE_DB_PATH=data/memory.db
CHROMA_PERSIST_DIR=data/chroma

# Pinned Chroma Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
